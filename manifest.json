{
  "manifest_version": 3,
  "name": "dejavu",
  "version": "0.0.1",
  "description": "Reads your open tabs and converts what you've already read into a SKILL.md your coding agent can execute later.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "history",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/panel/panel.html"
  },
  "action": {
    "default_title": "dejavu"
  }
}
